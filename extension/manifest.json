{
  "manifest_version": 3,
  "name": "NeuroSync \u2013 Read the Web Your Way",
  "version": "1.0.0",
  "description": "Applies your NeuroSync reading settings (fonts, spacing, bionic reading, reader mode, text-to-speech) to any website.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NeuroSync",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/neurosync-engine.js",
        "content/neurosync-selection.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/*.woff",
        "assets/fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}